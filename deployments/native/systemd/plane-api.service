[Unit]
Description=Plane API (gunicorn)
After=network.target postgresql.service redis-server.service rabbitmq-server.service silo.service
Wants=postgresql.service redis-server.service rabbitmq-server.service silo.service
PartOf=plane.target

[Service]
User=plane
Group=plane
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
EnvironmentFile=/opt/plane/shared/api.env
WorkingDirectory=/opt/plane/current/apps/api
ExecStart=/opt/plane/current/apps/api/.venv/bin/gunicorn -w ${GUNICORN_WORKERS} -k uvicorn.workers.UvicornWorker plane.asgi:application --bind 127.0.0.1:8100 --max-requests 1200 --max-requests-jitter 1000 --access-logfile -

[Install]
WantedBy=plane.target
