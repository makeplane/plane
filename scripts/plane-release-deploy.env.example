# /etc/plane-release-deploy.env — server-local deploy configuration
# Copy to /etc/plane-release-deploy.env and set permissions: chmod 0400 /etc/plane-release-deploy.env
# Owner: the OS user that runs the gitlab-runner process (e.g. gitlab-runner)
# This file must NOT be world-readable. Never store it in the git repository.
#
# Token rotation runbook:
#   1. Create new deploy token in GitLab → Settings → Repository → Deploy tokens
#      (scope: read_package_registry only)
#   2. Update DEPLOY_TOKEN below on each runner host
#   3. Set permissions: chmod 0400 /etc/plane-release-deploy.env
#   4. Verify: ls -la /etc/plane-release-deploy.env  (should show -r--------)

# Internal GitLab base URL (no trailing slash)
GITLAB_URL=https://gitlab.internal.example.com

# GitLab project numeric ID (find in Settings → General → Project ID)
PROJECT_ID=12345

# Package name in Generic Package Registry — must match what publish script uses
PACKAGE_NAME=plane-shb-release

# Deploy token with read_package_registry scope ONLY (not api, not write_*)
# Provision via GitLab → Settings → Repository → Deploy tokens
DEPLOY_TOKEN=gldt-xxxxxxxxxxxxxxxxxxxx

# Target environment — controls which tag prefix is accepted
#   dev  → accepts dev/* tags
#   prod → accepts prod/* tags only
TARGET_ENV=prod

# Deployment directory on this server — must match PLANE_DIR in .gitlab-ci.yml
PLANE_DIR=/root/Documents/plane-offline-pack/plane-app

# RELEASE_TAG — set here OR pass as a CI variable when triggering the job.
# CI variable takes precedence. Must always be explicit — no latest fallback.
# Examples:
#   dev  environment: dev/shb_v1.2.0-build.5
#   prod environment: prod/shb_v1.2.0
RELEASE_TAG=prod/shb_v1.2.0

# Number of archived release packages to keep locally for rollback (default: 3)
# ARCHIVE_KEEP=3
