# upload-release.env — local publish configuration (internal upload machine)
# Copy to upload-release.env (gitignored) and fill in your values.
# NEVER commit this file. Never store it on the GitLab server.
#
# Usage:
#   1. Transfer dist/ folder from Mac to this machine
#   2. Set DIST_DIR to the transferred dist/ path
#   3. Run: bash scripts/upload-release.sh dev/shb_v1.2.0
#      or:  bash scripts/upload-release.sh prod/shb_v1.2.0

# Internal GitLab base URL (no trailing slash)
GITLAB_URL=https://gitlab.internal.example.com

# GitLab project numeric ID (Settings → General → Project ID)
CI_PROJECT_ID=12345

# Project access token with write_package_registry + api scopes
# Provision via GitLab → Settings → Access Tokens
# Store ONLY on this internal machine — never in GitLab CI Variables
GITLAB_PUBLISH_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: ref used when creating the release tag target
# Default behavior:
#   - dev/* release tags  -> develop
#   - prod/* release tags -> preview
# Set this only if you want another branch/ref (must exist in GitLab project).
# TAG_REF=develop

# Source dist/ directory (where tar.gz files and .shb-version are)
DIST_DIR=./dist
