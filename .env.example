# DEVELOPMENT template. Copy it with ./setup.sh and use it with
# docker-compose-local.yml (see CONTRIBUTING.md).
#
# NOT for the server. A production .env is generated, not copied:
#
#   deployments/workspaces/init-env.sh
#
# It writes .env from deployments/workspaces/.env.example with real secrets. Copying
# this file onto a server instead would give you the password "workspaces", no
# SECRET_KEY, Caddy on port 80 fighting nginx, and no COMPOSE_FILE. See
# DEPLOYMENT.md.

# Database Settings
POSTGRES_USER="workspaces"
POSTGRES_PASSWORD="workspaces"
POSTGRES_DB="workspaces"
PGDATA="/var/lib/postgresql/data"

# Redis Settings
REDIS_HOST="workspaces-redis"
REDIS_PORT="6379"

# RabbitMQ Settings
RABBITMQ_HOST="workspaces-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="workspaces"
RABBITMQ_PASSWORD="workspaces"
RABBITMQ_VHOST="workspaces"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://workspaces-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880

# GPT settings
OPENAI_API_BASE="https://api.openai.com/v1" # deprecated
OPENAI_API_KEY="sk-" # deprecated
GPT_ENGINE="gpt-3.5-turbo" # deprecated

# Settings related to Docker
DOCKERIZED=1  # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# Live server (collaborative editing). Required: apps/live refuses to start
# without it. Generate with: openssl rand -hex 32
LIVE_SERVER_SECRET_KEY="secret-key"

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"
