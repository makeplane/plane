# Production .env — copy next to docker-compose.yml on the server.
# Compose interpolates Plane image names from these keys (username/repo-name:tag-name).

PLANE_IMAGE_FRONTEND=
PLANE_IMAGE_SPACE=
PLANE_IMAGE_ADMIN=
PLANE_IMAGE_LIVE=
PLANE_IMAGE_BACKEND=
PLANE_IMAGE_PROXY=

# Docker Hub credentials for private Plane image pulls.
# Watchtower is disabled; deploy with `docker compose pull && docker compose up -d`.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
PULL_POLICY=if_not_present

APP_DOMAIN=localhost
WEB_URL=http://${APP_DOMAIN}
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}
ALLOWED_HOSTS=*
API_BASE_URL=http://api:8000
DEBUG=0

# Database Settings
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# Redis Settings
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS / MinIO Settings
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
USE_MINIO=1

# Secret Key — change this before deploying to production.
SECRET_KEY=change-this-key-on-deployment
LIVE_SERVER_SECRET_KEY=change-this-key-on-deployment

GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# If SSL Cert to be generated, set CERT_EMAIL
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=
MINIO_ENDPOINT_SSL=0

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
