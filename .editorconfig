# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2

[*.toml]
indent_size = 2

[*.json]
indent_size = 2

[*.lock]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.js, *.ts, *.jsx, *.tsx]
indent_size = 2

[*.css, *.scss, *.sass]
indent_size = 2

[*.html]
indent_size = 2

[*.xml]
indent_size = 2

[*.swift]
indent_size = 4

[*.java]
indent_size = 4

[*.go]
indent_size = 4

[*.proto]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{cmake,h}]
indent_size = 2
