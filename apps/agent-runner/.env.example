PORT=3410
# Verifies the bridge's spawn tickets; must equal the bridge's AGENT_RUNNER_SECRET (32+ chars).
AGENT_RUNNER_SECRET="change-me-to-another-long-random-string"
# Per-user working dirs (<root>/<workspace_id>/<user_id>); must match the bridge's value.
AGENT_WORKSPACES_ROOT="/workspaces"
# uid: run each agent as its own unprivileged uid (needs root). none: local development only.
AGENT_RUNNER_ISOLATION="none"
# Development only: allow the deterministic echo test agent.
AGENT_RUNNER_ENABLE_ECHO="true"
