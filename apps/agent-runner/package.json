{
  "name": "agent-runner",
  "version": "1.5.0",
  "private": true,
  "description": "Runs the ACP stdio agents for the in-app agent chat, isolated per user and workspace, and serves them over ACP-on-WebSocket",
  "license": "AGPL-3.0",
  "author": "Plane Software Inc.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean --onSuccess \"node --env-file-if-exists=.env dist/start.mjs\"",
    "start": "node --env-file-if-exists=.env dist/start.mjs",
    "test": "vitest run",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@plane/acp-adapters": "workspace:*",
    "@plane/agent-runner-protocol": "workspace:*",
    "@plane/logger": "workspace:*",
    "express": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "agent-bridge": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
