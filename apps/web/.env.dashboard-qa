# Loaded with: react-router dev --mode dashboard-qa
#
# API calls and sign-in forms use SAME ORIGIN (localhost:3100); Vite proxies
# /api and /auth to the QA API on :8100. Do not set VITE_API_BASE_URL to :8100
# or login CSRF will fail (cross-host cookies).

VITE_API_BASE_URL=""
VITE_WEB_BASE_URL="http://localhost:3100"

VITE_ADMIN_BASE_URL="http://localhost:3001"
VITE_ADMIN_BASE_PATH="/god-mode"

VITE_SPACE_BASE_URL="http://localhost:3002"
VITE_SPACE_BASE_PATH="/spaces"

VITE_LIVE_BASE_URL="http://localhost:3100"
VITE_LIVE_BASE_PATH="/live"
