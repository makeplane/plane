# Agent bridge (in-app agent chat). The chat socket is <url><path>/acp and authenticates with the
# session cookie, so the bridge must be same-site. Empty URL: same origin as the web app.
VITE_AGENT_BRIDGE_BASE_URL="http://localhost:3400"
VITE_AGENT_BRIDGE_BASE_PATH="/agents"
