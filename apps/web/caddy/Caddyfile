{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests.
	# 300/min starved this single-instance deployment: all host traffic NATs to
	# one client IP, and React Router reloads the page when a chunk 429s, which
	# amplifies into a reload storm. 3000/min keeps the protection without the loop.
	rate_limit {
		zone static {
			key {client_ip}
			events 3000
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
