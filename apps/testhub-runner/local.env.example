# Copy to local.env (gitignored). Sourced by entrypoint.sh inside testhub-runner.
# Needed when Docker Desktop cannot complete TLS to github.com (handshake EOF)
# but the Windows host can reach a GitHub HTTPS mirror through a local proxy.

export HTTP_PROXY=http://host.docker.internal:7890
export HTTPS_PROXY=http://host.docker.internal:7890
export NO_PROXY=localhost,127.0.0.1,testhub-runner,api,worker
export GITSYNC_GITHUB_INSTEADOF=https://ghproxy.net/https://github.com/
