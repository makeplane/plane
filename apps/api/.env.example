# ==============================================================
# Plane API — Environment Variables Example
# ==============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ==============================================================

# Backend
DEBUG=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password-here"
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS / MinIO Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
AWS_S3_ENDPOINT_URL_EXTERNAL="http://localhost:9005"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

# Docker
DOCKERIZED=1
USE_MINIO=1

# URLs
WEB_URL="http://localhost:8000"
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"
APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""
LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="secret-key"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Django Secret Key
SECRET_KEY="your-django-secret-key-here"

# IMAP Email Ingestion (Legacy — Support Tickets / SecOps)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_EMAIL=akash.barnwal@winjit.com
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=60
SECOPS_DEFAULT_PROJECT_ID=your-project-uuid-here

# Microsoft OAuth2 (Azure App Registration for IMAP XOAUTH2)
MS_OAUTH_TENANT_ID=your-tenant-id-here
MS_OAUTH_CLIENT_ID=your-client-id-here
MS_OAUTH_CLIENT_SECRET=your-client-secret-here

# Microsoft Graph API Email Ingestion (ingest_emails command)
# These are the preferred keys for the Graph API service.
# Falls back to MS_OAUTH_* if not set.
GRAPH_TENANT_ID=your-tenant-id-here
GRAPH_CLIENT_ID=your-client-id-here
GRAPH_CLIENT_SECRET=your-client-secret-here
GRAPH_MAILBOX=akash.barnwal@winjit.com
EMAIL_TARGET_PROJECT_ID=your-project-uuid-here
EMAIL_POLL_INTERVAL=60
EMAIL_BATCH_SIZE=50
