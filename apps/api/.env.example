# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0

# REQUIRED IN PRODUCTION. Left unset, Django generates a random key at import
# time -- which means the api, worker and beat containers each hold a different
# one, and every restart silently invalidates every session and password-reset
# link. Generate one and paste it in:
#
#   python3 -c "from django.utils.crypto import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=""
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Database Settings
POSTGRES_USER="workspaces"
POSTGRES_PASSWORD="workspaces"
POSTGRES_HOST="workspaces-db"
POSTGRES_DB="workspaces"
POSTGRES_PORT=5432
# Optional. settings/common.py prefers DATABASE_URL over the POSTGRES_*
# variables the moment it is non-empty. Whether ${...} placeholders inside an
# env_file are expanded depends on the Compose version (2.24 and newer expand
# them, older releases pass them through literally, which yields a database
# host called "${POSTGRES_HOST}"). Leave it commented out and let Django use
# the discrete variables above, or write the URL out in full.
# DATABASE_URL=postgresql://workspaces:workspaces@workspaces-db:5432/workspaces

# Redis Settings
REDIS_HOST="workspaces-redis"
REDIS_PORT="6379"
# Written out in full so it does not depend on env_file placeholder expansion
# (see DATABASE_URL above). REDIS_URL is what Celery, the cache backend and the
# bridge's rate limiter all read.
REDIS_URL="redis://workspaces-redis:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="workspaces-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="workspaces"
RABBITMQ_PASSWORD="workspaces"
RABBITMQ_VHOST="workspaces"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Attendance — the Atlas Odoo bridge.
# Server-side only; never expose either value to the browser.
# The API runs in a container, so this host must resolve from inside it —
# "localhost" points at the container itself and will always fail.
# Leave blank to disable attendance entirely (the navbar control hides itself).
ODOO_BASE_URL=""
ODOO_API_KEY=""
