# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
# Origins allowed to call the API from a browser. These are also trusted for
# CSRF (unsafe requests such as the login form POST).
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"
# Extra origins trusted for CSRF only. Add the LAN IP, Tailscale IP/hostname or
# domain the app is opened from, e.g.
# CSRF_TRUSTED_ORIGINS="http://192.168.1.20:3000,http://my-host.tailnet.ts.net:3000"
CSRF_TRUSTED_ORIGINS=""

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# ---------------------------------------------------------------------------
# Registration policy
# ---------------------------------------------------------------------------
# ENABLE_SIGNUP=0 closes self-serve signup and leaves registration to invite
# codes (research module) or pending workspace invitations. The web app keeps
# the "Create an account" entry visible either way - a closed instance is
# invitation-only, not entry-less. Set to 1 to re-open walk-in signup.
ENABLE_SIGNUP=0

# ---------------------------------------------------------------------------
# Research module (Plane for AI4MS)
# ---------------------------------------------------------------------------
# Deployment level master switch. Only "1" turns the module on; when it is off
# no research route is registered and the web app renders the stock navigation.
RESEARCH_MODULE_ENABLED=0

# AI4MS OIDC / SSO. Leave empty to keep the built-in account login path.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid profile email"
OIDC_ENABLE_PKCE=1
OIDC_AUTO_PROVISION_USERS=0
OIDC_PROVIDER_NAME="ai4ms-oidc"

# Research attachment limits (MB). Overridable per workspace.
RESEARCH_IMAGE_MAX_MB=20
RESEARCH_PDF_MAX_MB=100
RESEARCH_MARKDOWN_MAX_MB=5

# P1 sub switches. Workspace settings can override these defaults.
RESEARCH_STAGE_ENABLED=1
RESEARCH_EXPERIMENT_ENABLED=1
RESEARCH_CODE_ENABLED=1
RESEARCH_INTEGRATION_ENABLED=1

# P1 gate defaults. Stage requirements and workspace settings take priority.
RESEARCH_LITERATURE_MIN_INCLUDED=20
RESEARCH_LITERATURE_MAX_ENTRIES=100
RESEARCH_STAGE_MIN_REVIEWERS=3
RESEARCH_STAGE_PASS_RATIO=0.5
RESEARCH_CODE_SNAPSHOT_MAX_MB=500

# Integration base layer: timeout, cache and degraded mode (link_only | hidden).
RESEARCH_INTEGRATION_TIMEOUT_SECONDS=3
RESEARCH_INTEGRATION_CACHE_TTL_SECONDS=300
RESEARCH_INTEGRATION_DEGRADED_MODE=link_only

# External system credentials (backend only). The base URL, auth mode and
# credential reference name are configured per workspace in the research UI.
# RAGPORTAL_AUTH_SECRET=
# WEKNORA_AUTH_SECRET=
# SPECLABOS_AUTH_SECRET=
# SMARTACCESS_AUTH_SECRET=
# POLY_AGENT_AUTH_SECRET=
# SPEC_AGENT_AUTH_SECRET=
