# Every API image builds with ./apps/api as its context, so the repo-root
# .dockerignore never applies here.
# Local virtualenvs hold host-platform binaries.
.venv
venv
# Secrets generated by setup.sh; compose passes them in via env_file.
.env
# Host bytecode (patterns are anchored to the context root, hence **/).
**/__pycache__
**/*.pyc
