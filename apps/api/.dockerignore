# Build context for the api image.
#
# The root .dockerignore does NOT apply here: Docker reads the ignore file from
# the build context root, and compose builds this service with
# `context: ./apps/api`. Without this file every __pycache__ directory in the
# tree (89 of them at the time of writing), the local log file and any local
# virtualenv are shipped into the context and copied into the image by
# `COPY workspaces workspaces/`.

# Secrets. Not copied by the Dockerfile today, but keeping them out of the
# context means a future COPY cannot leak them by accident.
.env
.env.*
!.env.example

# Python build artefacts
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Local virtualenvs
venv/
.venv/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Runtime output. `workspaces/logs` is created by the image and written at runtime;
# a copy of the host's log file has no business in it.
workspaces/logs/
workspaces/static-assets/
mediafiles/

# NOTE: `tests/`, `pytest.ini` and `run_tests.*` are deliberately NOT ignored.
# Dockerfile.dev does a bare `COPY . .` and is what docker-compose-test.yml
# builds; excluding them would leave anyone who runs that image without the
# bind mount with no test suite.

# OS junk
.DS_Store
