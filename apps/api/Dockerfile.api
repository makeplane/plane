FROM python:3.12.10-alpine

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_PREFER_BINARY=1
ENV PIP_DEFAULT_TIMEOUT=120
ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/

# Update system packages for security (retry on transient Alpine CDN/SSL failures)
RUN for i in 1 2 3; do apk update && apk upgrade && break || sleep 10; done

WORKDIR /code

RUN for i in 1 2 3; do \
    apk add --no-cache --upgrade \
        bash \
        libpq \
        libxslt \
        xmlsec \
        ca-certificates \
        openssl \
    && break || sleep 10; \
    done

COPY requirements.txt ./
COPY requirements ./requirements

# Build deps for C extensions only (no cargo/rust — avoids ~300MB Alpine rust download that often fails on slow networks)
RUN for attempt in 1 2 3; do \
    apk add --no-cache --virtual .build-deps \
        g++ \
        gcc \
        make \
        libffi-dev \
        postgresql-dev \
        libc-dev \
        linux-headers \
    && pip install -r requirements.txt --no-cache-dir \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/* \
    && break; \
    apk del .build-deps 2>/dev/null || true; \
    rm -rf /var/cache/apk/*; \
    echo "pip/build-deps attempt ${attempt} failed, retrying..."; \
    sleep 15; \
    done


# Add in Django deps and generate Django's static files
COPY manage.py manage.py
COPY plane plane/
COPY templates templates/
COPY package.json package.json

COPY ./bin ./bin/

RUN mkdir -p /code/plane/logs
RUN chmod +x ./bin/*
RUN chmod -R 777 /code

# Expose container port and run entry point script
EXPOSE 8000

CMD ["./bin/docker-entrypoint-api.sh"]