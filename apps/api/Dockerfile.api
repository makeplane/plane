FROM python:3.12.10-alpine

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 
ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/

# Update system packages for security
RUN apk update && apk upgrade

WORKDIR /code

RUN apk add --no-cache --upgrade \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

COPY requirements.txt ./
COPY requirements ./requirements
# libffi-dev is only needed to compile wheels, so it belongs in .build-deps with
# the rest of the toolchain. Installed on its own it survives `apk del` below
# and stays in the final image for nothing.
RUN apk add --no-cache --virtual .build-deps \
    "bash~=5.2" \
    "libffi-dev" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers" \
    && \
    pip install -r requirements.txt --compile --no-cache-dir \
    && \
    apk del .build-deps \
    && \
    rm -rf /var/cache/apk/*


# Add in Django deps and generate Django's static files
COPY manage.py manage.py
COPY workspaces workspaces/
COPY templates templates/
COPY package.json package.json

RUN apk --no-cache add "bash~=5.2"
COPY ./bin ./bin/

# Only two paths are written at runtime: the log directory, and the static root
# that `collectstatic` fills in at container start. A recursive chmod over /code
# rewrites the mode of every file, which makes the layer a second copy of the
# entire tree -- and grants write access to the source for no reason.
# Both live under BASE_DIR, which settings/common.py resolves to /code/workspaces
# (the directory holding the settings package, not the repo root).
RUN mkdir -p /code/workspaces/logs /code/workspaces/static-assets/collected-static \
    && chmod +x ./bin/* \
    && chmod -R 777 /code/workspaces/logs /code/workspaces/static-assets

# Expose container port and run entry point script
EXPOSE 8000

# No HEALTHCHECK here on purpose. This one image is also the worker, the beat
# scheduler and the migrator, and none of those listen on 8000 -- a check baked
# in here would mark three healthy containers unhealthy forever. The api
# service gets its check in the compose overlay, where it applies to the one
# role that actually serves HTTP.

CMD ["./bin/docker-entrypoint-api.sh"]