PORT=3400
API_BASE_URL="http://localhost:8000"
# Shared with the API (AGENT_BRIDGE_SECRET there); sent as X-Agent-Bridge-Secret.
AGENT_BRIDGE_SECRET="change-me-to-a-long-random-string"
# The agent runner's ACP WebSocket endpoint and the secret that signs spawn tickets (32+ chars).
AGENT_RUNNER_URL="ws://localhost:3410/acp"
AGENT_RUNNER_SECRET="change-me-to-another-long-random-string"
AGENT_BRIDGE_BASE_PATH="/agents"
# Browser origins allowed to open the chat socket (comma separated). Empty: same host only.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
