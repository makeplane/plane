{
	auto_https off
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static 0.0.0.0/0
	}
}

:80 {
	encode zstd gzip

	# A Help Center bundle import carries the guide's screenshots, so it needs a
	# larger body than a single attachment. Raise the cap on just that route; every
	# other upload stays at FILE_SIZE_LIMIT (the two matchers are mutually exclusive
	# so each request hits exactly one request_body handler).
	@help_bundle_import path /api/instances/help/import/
	request_body @help_bundle_import {
		max_size {$HELP_BUNDLE_MAX_SIZE:300MB}
	}

	@standard_upload {
		not path /api/instances/help/import/
	}
	request_body @standard_upload {
		max_size {$FILE_SIZE_LIMIT}
	}

	# Frontend dev servers on host machine
	redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* host.docker.internal:3002

	redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* host.docker.internal:3001

	reverse_proxy /live/* host.docker.internal:3003

	# Backend in Docker
	reverse_proxy /api/* api:8000
	reverse_proxy /auth/* api:8000
	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	# Web app on host
	reverse_proxy /* host.docker.internal:3000
}
