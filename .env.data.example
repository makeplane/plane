# Data VM (plane-data) — copy to .env on the data host.
# Used by: docker compose -f docker-compose.data.yml
#
# Generate strong passwords before production. Values must match apps/api/.env on the app VM.

# Bind published ports to this address (data VM internal IP recommended, e.g. 10.128.0.10).
# Use 0.0.0.0 only if GCP firewall already restricts ingress to the app VM.
PLANE_BIND_ADDRESS=0.0.0.0

# Postgres
POSTGRES_USER="plane"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# RabbitMQ
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="change-me"
RABBITMQ_VHOST="plane"

# MinIO (must match AWS_* on app VM apps/api/.env)
AWS_ACCESS_KEY_ID="change-me-access-key"
AWS_SECRET_ACCESS_KEY="change-me-secret-key"
AWS_S3_BUCKET_NAME="uploads"
