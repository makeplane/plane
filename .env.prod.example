# Production .env — copy next to docker-compose.yml on the server.
# Treat the real file as secret. Do not commit it.
#
# SECURITY: earlier revisions of this example (and docker-compose-prod.yml)
# contained live production secrets restored from the commercial stack.
# If those committed values were ever used on the VPS, rotate them on the
# host now: SECRET_KEY, LIVE_SERVER_SECRET_KEY, AES_SECRET_KEY,
# MACHINE_SIGNATURE, PI_INTERNAL_SECRET, SILO_HMAC_SECRET_KEY,
# INSTANCE_ID, WEBHOOK_SECRET, and any OAuth/API secrets.
# This file only documents keys. It does not contain those values.

# Full image refs (username/repo-name:tag-name). Use the GitHub Actions
# repository variable values verbatim. Never append another tag.
# Example: PLANE_IMAGE_FRONTEND=hizidan/projects:plane-web-prod
PLANE_IMAGE_FRONTEND=
PLANE_IMAGE_SPACE=
PLANE_IMAGE_ADMIN=
PLANE_IMAGE_LIVE=
PLANE_IMAGE_BACKEND=
PLANE_IMAGE_PROXY=

# Docker Hub credentials for private Plane image pulls.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
PULL_POLICY=always

APP_DOMAIN=localhost
WEB_URL=http://${APP_DOMAIN}
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}
ALLOWED_HOSTS=*
API_BASE_URL=http://api:8000
DEBUG=0

# Database Settings
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# Redis Settings
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane
AMQP_URL=

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS / MinIO Settings
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
USE_MINIO=1

# Generate with:
#   python3 -c "from django.utils.crypto import get_random_secret_key; print(get_random_secret_key())"
#   openssl rand -hex 32
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# If SSL Cert to be generated, set CERT_EMAIL
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=
MINIO_ENDPOINT_SSL=0

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# Coordinated production deploys (P10A): do not enable Watchtower.
# After Branch Build CE, run GitHub workflow "Deploy Production" with the
# build run ID. See docs/implementations/p10a-coordinated-production-deploy.md
#
# Post-P9B operator rotation (on the host only; this file stays empty):
#   SECRET_KEY, LIVE_SERVER_SECRET_KEY, AES_SECRET_KEY, MACHINE_SIGNATURE,
#   webhook secrets, OAuth/API credentials, Docker Hub token if it was exposed.
# Do not paste replacement values into git.
