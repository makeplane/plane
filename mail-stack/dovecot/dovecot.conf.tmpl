protocols = imap lmtp sieve
listen = *

mail_location = maildir:/var/mail/vhosts/%d/%n/Maildir

ssl = required
ssl_cert = <__SSL_CERT_PATH__
ssl_key = <__SSL_KEY_PATH__

disable_plaintext_auth = yes
auth_mechanisms = plain login
auth_master_user_separator = *

passdb {
  driver = passwd-file
  master = yes
  args = /etc/dovecot/dovecot-master.passwd
}

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

userdb {
  driver = static
  args = uid=vmail gid=vmail home=/var/mail/vhosts/%d/%n
}

# The auth/LMTP sockets live in the shared dovecot-auth volume and are consumed
# by the Postfix process in the *other* container. The dovecot image has no
# "postfix" user, and matching UIDs across two images is fragile, so we grant
# access by socket mode (0666) instead of by owner. The volume is only shared
# between the trusted postfix/dovecot containers.
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0666
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0666
  }
}

protocol lmtp {
  postmaster_address = postmaster@${MAIL_DOMAIN}
  mail_plugins = $mail_plugins sieve
}

protocol imap {
  mail_plugins = $mail_plugins
}

# ManageSieve: the Gizmo Mail API uploads per-mailbox Sieve scripts (filters +
# out-of-office auto-reply) over this protocol, authenticating as the Dovecot
# master user exactly like the IMAP path. STARTTLS is required because
# disable_plaintext_auth is on; the API connects with STARTTLS + SASL PLAIN.
service managesieve-login {
  inet_listener sieve {
    port = 4190
  }
}

protocol sieve {
  managesieve_max_line_length = 65536
}

plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_extensions = +vacation +imap4flags +editheader +fileinto +copy +body +date +relational
}

namespace inbox {
  inbox = yes

  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }

  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }

  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }

  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }

  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
}

log_path = /dev/stderr
info_log_path = /dev/stdout
