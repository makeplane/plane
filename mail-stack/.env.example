# Apex domain for mail (example: gizmostudio.ru).
# Postfix will identify itself as mail.${MAIL_DOMAIN}; Dovecot will store
# mailboxes under /var/mail/vhosts/${MAIL_DOMAIN}/<user>/Maildir; Rspamd
# will sign outgoing mail as d=${MAIL_DOMAIN}.
#
# IMPORTANT: in production this must match MAIL_DOMAIN in the parent Gizmo .env
# so that the Let's Encrypt cert issued by Caddy matches the SMTP/IMAP TLS
# hostname.
#
# LOCAL MODE (no public domain): leave this empty (or unset) and run
# `./setup.sh start all`. setup.sh will default MAIL_DOMAIN to "mail.local",
# set MAIL_LOCAL=true, and the Postfix/Dovecot entrypoints will generate a
# self-signed certificate so the stack starts without Caddy/Let's Encrypt.
# Mailboxes/aliases are stored in plane-db and managed from god-mode -> Mail.
MAIL_DOMAIN=

# Set automatically by setup.sh. "true" => local/self-signed mode.
MAIL_LOCAL=

# Postgres connection used by Postfix (virtual maps) and Dovecot (auth). These
# are inherited from the parent Gizmo .env; override only if your DB differs.
POSTGRES_HOST=plane-db

# Dovecot master-user credentials used by Gizmo Mail API for live IMAP access.
# Set the same values in the root Gizmo .env / InstanceConfiguration as
# MAIL_MASTER_USER and MAIL_MASTER_PASSWORD.
MAIL_MASTER_USER=master
MAIL_MASTER_PASSWORD=

# ManageSieve endpoint used by the Gizmo Mail API to deploy per-mailbox filters
# and the out-of-office auto-reply (server-side Sieve, executed by Dovecot at
# delivery time). Defaults match the Dovecot service inside the mail-stack
# network; override only if Dovecot is reachable elsewhere.
MAIL_SIEVE_HOST=dovecot
MAIL_SIEVE_PORT=4190
# STARTTLS is required (disable_plaintext_auth is on). Set to 0 only if you
# terminate TLS differently.
MAIL_SIEVE_STARTTLS=1
