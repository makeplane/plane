{
  "name": "@plane/acp-adapters",
  "version": "1.5.0",
  "private": true,
  "description": "Agent Client Protocol (ACP) stdio adapters for the in-app agent chat: Claude, Codex, Gemini, DeepSeek and an echo test agent, plus the provider sign-in helper",
  "license": "AGPL-3.0",
  "bin": {
    "plane-acp-claude": "./dist/bin/claude.mjs",
    "plane-acp-codex": "./dist/bin/codex.mjs",
    "plane-acp-deepseek": "./dist/bin/deepseek.mjs",
    "plane-acp-echo": "./dist/bin/echo.mjs",
    "plane-acp-gemini": "./dist/bin/gemini.mjs",
    "plane-agent-login": "./dist/bin/login.mjs"
  },
  "files": [
    "dist",
    "gemini"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "test": "vitest run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
