# App VM (plane-app) — copy to .env on the app host.
# Used by: docker compose -f docker-compose.app.yml (proxy + Vite build args)
#
# Also configure apps/api/.env and apps/live/.env (see deployments/gcp/README.md).

# --- Data VM internal IP (replace before deploy) ---
PLANE_DATA_HOST=10.128.0.10

# Public URL (baked into web/admin/space images at build time)
VITE_API_BASE_URL="https://plane.example.com"
VITE_WEB_BASE_URL="https://plane.example.com"
VITE_ADMIN_BASE_URL="https://plane.example.com"
VITE_SPACE_BASE_URL="https://plane.example.com"
VITE_LIVE_BASE_URL="https://plane.example.com"

# Proxy / TLS
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
SITE_ADDRESS=:443
CERT_EMAIL=admin@example.com
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0
FILE_SIZE_LIMIT=5242880
AWS_S3_BUCKET_NAME=uploads

# --- apps/api/.env (copy from apps/api/.env.example, then set) ---
# POSTGRES_HOST=<PLANE_DATA_HOST>
# POSTGRES_PASSWORD=<same as data VM .env>
# REDIS_HOST=<PLANE_DATA_HOST>
# REDIS_URL=redis://<PLANE_DATA_HOST>:6379/
# RABBITMQ_HOST=<PLANE_DATA_HOST>
# RABBITMQ_PASSWORD=<same as data VM .env>
# AWS_S3_ENDPOINT_URL=http://<PLANE_DATA_HOST>:9000
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY=<same as data VM .env>
# WEB_URL=https://plane.example.com
# CORS_ALLOWED_ORIGINS=https://plane.example.com
# USE_MINIO=1
# SECRET_KEY=<generate>
# LIVE_SERVER_SECRET_KEY=<generate>

# --- apps/live/.env (copy from apps/live/.env.example, then set) ---
# REDIS_HOST=<PLANE_DATA_HOST>
# REDIS_URL=redis://<PLANE_DATA_HOST>:6379/
# WEB_BASE_URL=https://plane.example.com
# LIVE_BASE_URL=https://plane.example.com/live
# LIVE_SERVER_SECRET_KEY=<same as apps/api/.env>
