FROM node:22-alpine

# Install system dependencies
RUN apk add --no-cache libc6-compat bash curl iproute2

# Setup pnpm
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
RUN corepack enable pnpm && pnpm add -g turbo@2.9.4

# Disable telemetry
ENV TURBO_TELEMETRY_DISABLED=1
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Everything is volume-mounted at runtime for HMR support
# The entrypoint handles package builds and dev server startup
COPY docker-entrypoint-frontend.sh /usr/local/bin/docker-entrypoint-frontend.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-frontend.sh

ENTRYPOINT ["docker-entrypoint-frontend.sh"]
